		Items: {
			ArcaneQuiver: {
				DisplayName: 奥术箭袋
				Tooltip:
					'''
					可以消耗魔力为箭矢附魔，造成额外伤害
					魔力消耗取决于武器攻速
					打开饰品可见性将把任何种类的箭矢替换为追踪的奥术箭
					法力充盈时，奥术箭的伤害更高
					如果患有魔力病，奥术箭的伤害减半
					箭的速度大大提高
					20%的几率不消耗箭
					“魔法，能量。我的人民陷入其中不能自拔!”
					'''
			}

			EvilMushroom: {
				DisplayName: 恶毒的蘑菇
				Tooltip: 你和被命中的敌人均获得死亡标记
			}

			FastHolster: {
				DisplayName: 快拔枪套
				Tooltip:
					'''
					枪械的使用时间减少10%
					远程暴击率减少4%
					“不要在乎打得准不准，只要打得多，就是打得准！”
					'''
			}

			GrapeLauncher: {
				DisplayName: 霰弹下挂
				Tooltip: 连续命中敌人8次后发射一连串子弹
			}

			InfectedCrabGill: {
				DisplayName: 感染蟹腮
				Tooltip:
					'''
					随着时间推移召唤可以伤害敌人的孢子
					发射远程弹幕时有概率额外射出命中后分裂的真菌弹
					减少1点生命再生
					'''
			}

			LifeMushroom: {
				DisplayName: 一般路过的蘑菇
				Tooltip: 在玩家附近生成一个治愈蘑菇，拾取后恢复15点生命值
			}

			MarvelousMycelium: {
				DisplayName: 神奇菌丝
				Tooltip:
					'''
					未受伤时减少5点防御与1点生命再生，提升6%远程伤害与9%远程暴击率
					受伤后给予5秒与菇共生buff，期间减少6%远程伤害与9%远程暴击，不再减少生存属性
					死亡延续生命，生命成就死亡
					'''
			}

			ModifiedCoil: {
				DisplayName: 魔改线圈
				Tooltip:
					'''
					远程伤害+7%
					小幅提升远程弹幕的飞行速度
					可能会漏电
					'''
			}

			MushroomUnitedNations: {
				DisplayName: 蘑拟黏合国
				Tooltip:
					'''
					未受伤时减少5点防御与2点生命再生，提升15%远程伤害与5%远程暴击率
					这个效果在受伤后短暂反转
					随着时间推移召唤可以伤害敌人的孢子
					发射远程弹幕时有概率额外射出命中后分裂的真菌弹
					按下“[KEY]”以激活或禁用幻菇中毒
					一杆蘑菇狙击枪悬浮在你的头顶，狙杀进入射程的敌人
					敌人将不那么容易瞄准你
					“我怎么感觉我们的成员越来越少了？“
					'''
			}

			OdddMushroom: {
				DisplayName: 致幻蘑菇
				Tooltip:
					'''
					按下“[KEY]”以激活或禁用幻菇中毒
					“眼睛所见的，未必真实”
					'''
			}

			SuperCoil: {
				DisplayName: 精金线圈
				Tooltip:
					'''
					提高远程暴击率
					远程武器的攻速越快，越容易暴击
					中幅提升远程弹幕的飞行速度
					'''
			}

			TitaniumCoil: {
				DisplayName: 钛金线圈
				Tooltip:
					'''
					提高远程伤害
					远程武器的攻速越慢，伤害越高
					中幅提升远程弹幕的飞行速度
					'''
			}

			WulfrumCoil: {
				DisplayName: 钨钢线圈
				Tooltip:
					'''
					远程伤害+7%
					略微提升远程弹幕的飞行速度
					'''
			}

			AstralArrow: {
				DisplayName: 幻星箭
				Tooltip: 击败诞生于星辰之间的恐惧以完成进化
			}

			AstralBullet: {
				DisplayName: 幻星子弹
				Tooltip: 击败诞生于星辰之间的恐惧以完成进化
			}

			DazzlingAstralArrow: {
				DisplayName: 炫星箭
				Tooltip:
					'''
					星星，排列好了！
					你确定？
					'''
			}

			DazzlingAstralBullet: {
				DisplayName: 炫星子弹
				Tooltip: 行星，恒星，力量就在其中！
			}

			FossilArrow: {
				DisplayName: 化石箭
				Tooltip:
					'''
					坚固的化石击碎敌人的防御
					酸腐的化石释放积年的余毒
					'''
			}

			FossilBullet: {
				DisplayName: 化石子弹
				Tooltip:
					'''
					坚固的化石击碎敌人的防御
					酸腐的化石释放积年的余毒
					'''
			}

			HydrothermicArrow: {
				DisplayName: 渊泉箭
				Tooltip:
					'''
					击中敌人后释放渊泉爆炸
					“以子之矛攻子之盾，就会产生......” 
					'''
			}

			HydrothermicBullet: {
				DisplayName: 渊泉子弹
				Tooltip:
					'''
					击中敌人时在其脚下生成一座微型渊泉火山
					微型渊泉火山会喷射火柱和渊泉火焰
					“我的身体内部，可是一千四百度喔。”
					'''
			}

			NapalmBullet: {
				DisplayName: 汽油弹
				Tooltip:
					'''
					造成涂油和着火了！
					“一点点火光，谁也烧不到！”
					'''
			}

			PerennialSeed: {
				DisplayName: 永恒种子
				Tooltip: 长盛不衰
			}

			WeakAstralArrow: {
				DisplayName: 尘星箭
				Tooltip: “蠕虫说，是的我有很多父亲”
			}

			WeakAstralBullet: {
				DisplayName: 尘星子弹
				Tooltip:
					'''
					力量还不够......
					在击败被星辉瘟疫侵蚀的机械巨兽后，进化
					'''
			}

			ElementalBullet: {
				DisplayName: 天体萝卜
				Tooltip:
					'''
					击中敌人会让后续同种弹幕获得100%伤害加成
					此加成会在0.25秒内线性衰减至0
					造成元素谐鸣减益
					'''
			}

			GoldenFeatherArrow: {
				DisplayName: 金羽箭
				Tooltip:
					'''
					可能会吸引某些小东西
					击中敌人且未暴击时召唤红色的闪电
