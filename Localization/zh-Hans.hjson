					射击降低敌人的伤害减免
					“和死亡跳支舞吧！”
					'''
			}

			FrigidCoil: {
				DisplayName: 极寒线圈
				Tooltip:
					'''
					远程速度减少10%
					中幅提升远程弹幕的飞行速度
					远程弹幕会造成霜火减益
					击中敌人时在其四周放置寒冰炸弹
					这个效果有5秒冷却
					'''
			}

			ScorchingCoil: {
				DisplayName: 焦热线圈
				Tooltip:
					'''
					远程暴击增加7%
					中幅提升远程弹幕的飞行速度
					远程弹幕会造成硫磺火减益
					每击中敌人6次释放一波深渊亡魂
					能够多次伤害敌人的弹幕只会计算一次
					'''
			}

			AutoCalculationCoil: {
				DisplayName: 老登的自动演算线圈
				Tooltip:
					'''
					中幅提升远程弹幕的飞行速度
					远程弹幕会自动寻的
					按[KEY]在不同的搜寻算法间切换
					'''
			}

			TransformerCoil: {
				DisplayName: 变压线圈
				Tooltip:
					'''
					较大幅度提升远程弹幕的飞行速度
					远程弹幕会造成带电减益，你免疫带电
					一束电流会在你击中的最后两个敌人之间跳动
					'''
			}

